# Server Configuration
PORT=5000

# Database Configuration
# Required: startup fails if missing or unreachable; no temporary database fallback
MONGODB_URI=mongodb://localhost:27017/bookease

# JWT Secret Key
JWT_SECRET=your_jwt_secret_key_here

# Optional email delivery. Without SMTP_URL, emails use Ethereal previews or local JSON.
# SMTP_URL=smtps://username:password@smtp.example.com:465
# MAIL_FROM=BookEase <bookings@example.com>

# Bookings, wallet changes, scheduling and waitlist offers require MongoDB Atlas or a replica set.
# APP_URL=http://localhost:3000
# EMAIL_TRANSPORT=json
